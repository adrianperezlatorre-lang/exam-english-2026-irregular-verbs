<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Irregular Verbs Drill</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Atkinson+Hyperlegible:wght@400;700&family=JetBrains+Mono:wght@500&display=swap">
<style>
/* Layout: single study column, sticky score bar, one table that scrolls inside its own box */
:root{
  --bg:#eef2f6; --paper:#ffffff; --ink:#18212e; --muted:#5d6b7c; --line:#d4dce6;
  --accent:#2747c9; --accent-soft:#e3e9ff; --ok:#11804a; --ok-soft:#dcf3e6; --bad:#c2321f; --bad-soft:#fde4df;
  --head:#000000; --head-fg:#ffffff;
  --f-display:"Bricolage Grotesque", system-ui, sans-serif;
  --f-body:"Atkinson Hyperlegible", system-ui, sans-serif;
  --f-mono:"JetBrains Mono", ui-monospace, monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#10151d; --paper:#171e29; --ink:#e6ecf4; --muted:#93a1b3; --line:#2a3443;
  --accent:#8ea4ff; --accent-soft:#1e2a52; --ok:#52d08d; --ok-soft:#123425; --bad:#ff8a78; --bad-soft:#3d1a15;
  --head:#000000; --head-fg:#ffffff; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#10151d; --paper:#171e29; --ink:#e6ecf4; --muted:#93a1b3; --line:#2a3443;
  --accent:#8ea4ff; --accent-soft:#1e2a52; --ok:#52d08d; --ok-soft:#123425; --bad:#ff8a78; --bad-soft:#3d1a15;
  --head:#000000; --head-fg:#ffffff; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.45}
.wrap{max-width:820px;margin:0 auto;padding-inline:16px;padding-block:28px 60px;display:grid;gap:18px}
h1{font-family:var(--f-display);font-weight:800;font-size:clamp(28px,6vw,42px);line-height:1.05;margin:0;letter-spacing:-.01em;text-wrap:balance}
.lede{margin:0;color:var(--muted);max-width:62ch}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);padding-block:10px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;border-bottom:1px solid var(--line)}
.score{font-family:var(--f-mono);font-variant-numeric:tabular-nums;font-size:14px;display:flex;gap:14px;flex-wrap:wrap;margin-right:auto}
.score b{color:var(--ok)} .score .x{color:var(--bad)}
.meter{flex-basis:100%;height:6px;background:var(--line);border-radius:3px;overflow:hidden}
.meter i{display:block;height:100%;width:0;background:var(--ok);transition:width .3s}
button,select{font:inherit;font-size:14px;padding:8px 14px;border-radius:8px;border:1px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer}
button.primary{background:var(--accent);border-color:var(--accent);color:var(--paper);font-weight:700}
button:hover,select:hover{border-color:var(--accent)}
button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:1px}
.tablebox{overflow-x:auto;background:var(--paper);border:1px solid var(--line);border-radius:10px}
table{width:100%;border-collapse:collapse;min-width:420px}
thead th{background:var(--head);color:var(--head-fg);font-family:var(--f-display);font-weight:600;font-size:12px;letter-spacing:.08em;text-transform:uppercase;text-align:left;padding:10px 10px}
thead th.n{width:42px;text-align:right}
td{border-top:1px solid var(--line);padding:6px 8px;vertical-align:middle}
td.n{font-family:var(--f-mono);font-size:12px;color:var(--muted);text-align:right;font-variant-numeric:tabular-nums}
.clue{font-weight:700;font-size:17px;padding-left:10px}
.gloss{display:block;font-weight:400;font-size:12px;color:var(--muted)}
input{width:100%;font:inherit;font-size:16px;padding:7px 9px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink)}
input.ok{background:var(--ok-soft);border-color:var(--ok);color:var(--ok);font-weight:700}
input.bad{background:var(--bad-soft);border-color:var(--bad);color:var(--bad)}
.sol{display:block;font-size:12px;color:var(--bad);margin-top:2px;min-height:0}
.foot{color:var(--muted);font-size:13px;margin:0}
@media (prefers-reduced-motion:reduce){.meter i{transition:none}}
</style>

<div class="wrap">
  <header>
    <h1>Irregular Verbs</h1>
  </header>
  <p class="lede">Cada fila muestra una forma del verbo. Escribe las otras dos. Pulsa Enter para comprobar y pasar al siguiente hueco. Si hay dos formas válidas (p. ej. <em>dreamt / dreamed</em>) vale cualquiera de las dos.</p>

  <div class="bar">
    <div class="score" aria-live="polite">
      <span>Bien: <b id="sOk">0</b></span>
      <span>Mal: <span class="x" id="sBad">0</span></span>
      <span>Huecos: <span id="sTot">0</span></span>
    </div>
    <select id="grp" aria-label="Grupo">
      <option value="all">Todos los grupos</option>
    </select>
    <button id="shuffle" class="primary">Nuevo reparto</button>
    <button id="checkAll">Comprobar todo</button>
    <button id="reveal">Ver soluciones</button>
    <div class="meter"><i id="meter"></i></div>
  </div>

  <div class="tablebox">
    <table>
      <thead><tr><th class="n">#</th><th>Simple form</th><th>Simple past</th><th>Past participle</th></tr></thead>
      <tbody id="tb"></tbody>
    </table>
  </div>
  <p class="foot">Lista: Irregular Verbs, Mnemonic Rhyming Groups 1 a 9 (Mr. Hani Al Tahrawi). En los verbos que se confunden se indica el significado en español.</p>
</div>

<script>
// group|base|past|participle|gloss   ("/" separates accepted alternatives)
const RAW = `
1|ring|rang|rung
1|sing|sang|sung
1|sink|sank|sunk
1|drink|drank|drunk
1|shrink|shrank|shrunk
1|swim|swam|swum
1|begin|began|begun
1|run|ran|run
2|feed|fed|fed
2|lead|led|led
2|breed|bred|bred
2|read|read|read|pasado se pronuncia "red"
2|sell|sold|sold
2|tell|told|told
2|slide|slid|slid
2|hold|held|held
3|hit|hit|hit
3|fit|fit|fit
3|spit|spit/spat|spit/spat
3|knit|knit/knitted|knit/knitted
3|quit|quit|quit
3|let|let|let
3|set|set|set
3|upset|upset|upset
3|shut|shut|shut
3|cut|cut|cut
3|put|put|put
3|cost|cost|cost
3|hurt|hurt|hurt
3|spread|spread|spread
3|broadcast|broadcast|broadcast
4|buy|bought|bought
4|fight|fought|fought
4|seek|sought|sought
4|think|thought|thought
4|bring|brought|brought
4|teach|taught|taught
4|catch|caught|caught
5|bend|bent|bent
5|send|sent|sent
5|lend|lent|lent
5|spend|spent|spent
5|build|built|built
5|sleep|slept|slept
5|keep|kept|kept
5|creep|crept|crept
5|weep|wept|wept
5|sweep|swept|swept
5|leap|leapt/leaped|leapt/leaped
5|feel|felt|felt
5|mean|meant|meant
5|dream|dreamt/dreamed|dreamt/dreamed
5|meet|met|met
5|leave|left|left
5|lose|lost|lost
5|burn|burnt/burned|burnt/burned
6|hang|hung|hung|colgar (un objeto)
6|hang|hanged|hanged|ahorcar
6|dig|dug|dug
6|shoot|shot|shot
6|stand|stood|stood
6|understand|understood|understood
6|stick|stuck|stuck
6|strike|struck|struck
6|sit|sat|sat
6|win|won|won
6|make|made|made
6|pay|paid|paid
6|lay|laid|laid|poner, colocar
6|say|said|said
6|light|lit/lighted|lit/lighted
6|find|found|found|encontrar
6|found|founded|founded|fundar
7|throw|threw|thrown
7|grow|grew|grown
7|blow|blew|blown
7|draw|drew|drawn
7|withdraw|withdrew|withdrawn
7|fly|flew|flown
7|know|knew|known
8|write|wrote|written
8|choose|chose|chosen
8|freeze|froze|frozen
8|speak|spoke|spoken
8|awake|awoke|awoken
8|break|broke|broken
8|steal|stole|stolen
8|ride|rode|ridden
8|rise|rose|risen
8|shake|shook|shaken
8|take|took|taken
8|overtake|overtook|overtaken
8|mistake|mistook|mistaken
8|fall|fell|fallen
8|forget|forgot|forgotten
8|hide|hid|hidden
8|shave|shaved|shaven/shaved
8|bite|bit|bitten
8|beat|beat|beaten
8|swear|swore|sworn
8|tear|tore|torn
8|wear|wore|worn
8|weave|wove|woven
8|forbid|forbade|forbidden
8|give|gave|given
8|forgive|forgave|forgiven
8|drive|drove|driven
8|eat|ate|eaten
8|get|got|got/gotten
8|prove|proved|proven/proved
8|show|showed|shown
8|wake|woke/waked|woken/waked
9|dive|dived/dove|dived
9|do|did|done
9|go|went|gone
9|hear|heard|heard
9|have|had|had
9|be/am/is/are|was/were|been|ser, estar
9|come|came|come
9|become|became|become
9|overcome|overcame|overcome
9|see|saw|seen|ver
9|saw|sawed|sawn/sawed|serrar
9|lie|lied|lied|mentir
9|lie|lay|lain|tumbarse, estar tumbado
`;
const VERBS = RAW.trim().split("\n").map(l=>{
  const [g,b,p,pp,gloss] = l.split("|");
  return {g:+g, forms:[b,p,pp], gloss:gloss||""};
});
const COLS = ["base","past","pp"];
const norm = s => s.toLowerCase().replace(/\s+/g," ").trim();
const accepted = f => f.split("/").map(norm);
const display = f => f.replace(/\//g," / ");

function isCorrect(value, form){
  const v = norm(value); if(!v) return null;
  const ok = accepted(form);
  const parts = v.split(/\s*(?:\/|,|\bor\b|\by\b)\s*/).filter(Boolean);
  return parts.length>0 && parts.every(p=>ok.includes(p));
}

const tb = document.getElementById("tb");
const grp = document.getElementById("grp");
for(let i=1;i<=9;i++){const o=document.createElement("option");o.value=i;o.textContent="Grupo "+i;grp.appendChild(o);}

function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

function build(){
  const sel = grp.value;
  const list = shuffle(VERBS.filter(v=>sel==="all"||v.g==+sel));
  tb.innerHTML="";
  list.forEach((v,idx)=>{
    const clue = Math.floor(Math.random()*3);
    const tr=document.createElement("tr");
    const n=document.createElement("td"); n.className="n"; n.textContent=idx+1; tr.appendChild(n);
    v.forms.forEach((f,c)=>{
      const td=document.createElement("td");
      if(c===clue){
        td.className="clue";
        td.textContent = display(f);
        if(v.gloss){const s=document.createElement("span");s.className="gloss";s.textContent=v.gloss;td.appendChild(s);}
      }else{
        const inp=document.createElement("input");
        inp.id=`v${idx}_${c}`; inp.autocomplete="off"; inp.autocapitalize="off"; inp.spellcheck=false;
        inp.setAttribute("aria-label",`${COLS[c]} de ${display(v.forms[clue])}`);
        inp.dataset.answer=f;
        const sol=document.createElement("span"); sol.className="sol";
        inp.addEventListener("blur",()=>check(inp));
        inp.addEventListener("input",()=>{inp.classList.remove("ok","bad");sol.textContent="";score();});
        inp.addEventListener("keydown",e=>{
          if(e.key==="Enter"){e.preventDefault();check(inp);focusNext(inp);}
        });
        td.append(inp,sol);
      }
      tr.appendChild(td);
    });
    tb.appendChild(tr);
  });
  score();
}
function inputs(){return [...tb.querySelectorAll("input")];}
function focusNext(inp){const all=inputs();const i=all.indexOf(inp);const next=all.slice(i+1).find(x=>!x.classList.contains("ok"));if(next)next.focus();}
function check(inp){
  const r=isCorrect(inp.value,inp.dataset.answer);
  const sol=inp.nextElementSibling;
  inp.classList.remove("ok","bad"); sol.textContent="";
  if(r===true) inp.classList.add("ok");
  else if(r===false){inp.classList.add("bad"); sol.textContent="→ "+display(inp.dataset.answer);}
  score();
}
function score(){
  const all=inputs();
  const ok=all.filter(x=>x.classList.contains("ok")).length;
  const bad=all.filter(x=>x.classList.contains("bad")).length;
  document.getElementById("sOk").textContent=ok;
  document.getElementById("sBad").textContent=bad;
  document.getElementById("sTot").textContent=all.length;
  document.getElementById("meter").style.width=(all.length?ok/all.length*100:0)+"%";
}
document.getElementById("shuffle").onclick=build;
grp.onchange=build;
document.getElementById("checkAll").onclick=()=>inputs().forEach(i=>{ if(norm(i.value)) check(i); else {i.classList.add("bad");i.nextElementSibling.textContent="→ "+display(i.dataset.answer);} score();});
document.getElementById("reveal").onclick=()=>inputs().forEach(i=>{if(!i.classList.contains("ok")){i.value=display(i.dataset.answer);i.classList.remove("bad");i.nextElementSibling.textContent="";}});
build();
</script>

</body></html>
